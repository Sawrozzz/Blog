<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.16/dist/tailwind.min.css" rel="stylesheet">
  </head>
  <body class="bg-zinc-900 text-black min-h-screen flex items-center justify-center">
    <div class="w-full max-w-md p-10">
      <h3 class="text-3xl mb-5 cursor-pointer text-center">Upload Profile Picture Here</h3>
      <form autocomplete="off" action="/upload" method="post" enctype="multipart/form-data" class="flex flex-col items-center">
        <input type="file" name="image" class="mb-4">
        <input class="px-5 py-2 rounded-md bg-blue-500 cursor-pointer w-full" type="submit" value="Upload" />
      </form>
    </div>
  </body>
</html>